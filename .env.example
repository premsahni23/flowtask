# ── Copy this to .env for local dev ──────────────────────────────────────────
# In Vercel: Project Settings → Environment Variables → add both keys

# OpenRouter API key — get yours free at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your deployed Vercel URL — used as HTTP-Referer for OpenRouter
# Change this to your actual deployment URL
APP_URL=https://flowtask-umber.vercel.app
